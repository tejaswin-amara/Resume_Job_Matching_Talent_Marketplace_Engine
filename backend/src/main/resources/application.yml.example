spring:
  datasource:
    url: jdbc:mysql://${DB_HOST:localhost}:3306/talent_engine?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
    username: ${DB_USER:root}
    password: ${DB_PASS:root}
  jpa:
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
  flyway:
    enabled: true

server:
  port: 8080

app:
  jwt:
    secret: ${JWT_SECRET}
    expiration: 86400000 # 24 hours
  engine:
    url: http://${ENGINE_HOST:localhost}:8000
